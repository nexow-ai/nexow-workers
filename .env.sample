# ============================================
# nexow-workers — Environment Variables
# ============================================

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=nexow:market:prices

# --- Internal service URLs ---
NEXOW_AGENTS_URL=http://localhost:8002
NEXOW_DATA_URL=http://localhost:8001

# --- Worker ---
TICK_INTERVAL_SECONDS=5

# --- Supabase (required by nexow-shared) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# --- Oanda (required by nexow-data) ---
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=your-account-id
OANDA_API_TOKEN=your-api-token

# --- LLM Providers (required by nexow-agents) ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key
NEWSAPI_KEY=your-newsapi-key
